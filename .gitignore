# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
wheelhouse/

# Virtual environments
.venv/
venv/
ENV/
env/
.env/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos
*.manifest
*.spec

# mypy
.mypy_cache/

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs and runtime data
logs/
*.log

# Jupyter
.ipynb_checkpoints/

# Local env files and secrets
.env
.env.*
*.pem
*.key
secrets.json

# Python bytecode cache
*.pyc

# Generated docs
docs/_build/

# Temporary files
*.tmp
*.swp
*~

# MuJoCo / system-specific artifacts (if accidentally copied)
mujoco/  # usually not checked in; keep this only if intentional

# Notebook checkpoints
.ipynb_checkpoints/

# Ignore distribution artifacts produced by pip
*.whl

# Optional: ignore local editable installs of env packages
# if you have installed envs/gym-maze-master/ as editable, you may
# want to keep the source in the repo; otherwise uncomment next line
# envs/gym-maze-master/
# envs/gym-navigation-main/

# Ignore PyCharm caches
.idea/

# End of file
